{
  "name": "crud-productos-api",
  "version": "1.0.0",
  "description": "API REST CRUD de productos (Express + TiDB Cloud) para Google Cloud Run",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "db:init": "node --env-file-if-exists=.env src/scripts/init-db.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "mysql2": "^3.24.6"
  }
}
