# Copia este archivo como .env y completa los valores.
# TiDB Cloud Console -> tu cluster -> botón "Connect" -> Connect With: "General"
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
# En TiDB Cloud Starter el usuario tiene un prefijo, ej: 2abcXYZ.root
DB_USER=xxxxxxxx.root
DB_PASSWORD=tu-password
DB_NAME=crud_productos
# TiDB Cloud exige TLS. Solo pon "false" si usas un TiDB/MySQL local sin TLS.
DB_SSL=true

# Orígenes permitidos por CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173

PORT=8080
