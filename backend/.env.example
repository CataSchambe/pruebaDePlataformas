# Copia este archivo como .env y completa los valores.
# Supabase Dashboard -> Project Settings -> API (o "API Keys")
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave SECRETA (sb_secret_... o la legacy "service_role"). ¡Solo en el backend!
SUPABASE_SERVICE_KEY=tu-clave-secreta

# Orígenes permitidos por CORS, separados por coma
ALLOWED_ORIGINS=http://localhost:5173

PORT=8080
